---
const options = [
    {value: 'auto', label: 'System', icon: '<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>'},
    {value: 'light', label: 'Light', icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>'},
    {value: 'dark', label: 'Dark', icon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>'},
];
---

<mc-theme-toggle class="theme-toggle" role="radiogroup" aria-label="Theme">
    {options.map(option => (
        <button type="button" role="radio" data-theme-value={option.value} aria-label={option.label} title={option.label}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={option.icon}/>
        </button>
    ))}
</mc-theme-toggle>

<script>
    // Starlight's own key and values, so its theme provider and the phone menu's select agree with this one.
    const KEY = 'starlight-theme';
    const media = window.matchMedia('(prefers-color-scheme: light)');

    const stored = () => {
        try {
            const value = localStorage.getItem(KEY);
            return value === 'light' || value === 'dark' ? value : 'auto';
        } catch {
            return 'auto';
        }
    };

    const apply = (choice: string) => {
        document.documentElement.dataset.theme = choice === 'auto' ? (media.matches ? 'light' : 'dark') : choice;
        document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((button) => {
            button.setAttribute('aria-checked', String(button.dataset.themeValue === choice));
        });
    };

    class ThemeToggle extends HTMLElement {
        connectedCallback() {
            apply(stored());

            this.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((button) => {
                button.addEventListener('click', () => {
                    const choice = button.dataset.themeValue || 'auto';
                    try {
                        localStorage.setItem(KEY, choice === 'auto' ? '' : choice);
                    } catch {}
                    apply(choice);
                });
            });
        }
    }

    media.addEventListener('change', () => { if (stored() === 'auto') apply('auto'); });

    customElements.define('mc-theme-toggle', ThemeToggle);
</script>

<style>
    .theme-toggle {
        display: inline-flex;
        gap: 0.15rem;
        padding: 0.2rem;
        border: 1px solid var(--sl-color-hairline);
        border-radius: 999px;
    }

    button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.85rem;
        height: 1.85rem;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--sl-color-gray-3);
        cursor: pointer;
    }

    button:hover { color: var(--sl-color-white); }

    button[aria-checked='true'] {
        background: var(--sl-color-gray-6);
        color: var(--sl-color-white);
    }

    svg { width: 1rem; height: 1rem; }
</style>
