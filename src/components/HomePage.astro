---
import {popularPages} from '../lib/sections.mjs';

// Lucide icons, the same set the plugin's admin uses.
const icons = {
    users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
    workflow: '<rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/>',
    chart: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
    settings: '<path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>',
    plug: '<path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/>',
    arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
    send: '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>',
    hand: '<path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"/><path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>',
    clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
    upload: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m17 8-5-5-5 5"/><path d="M12 3v12"/>',
    filter: '<path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z"/>',
    code: '<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>',
};

const steps = [
    {title: 'Install and set up sending', text: 'Activate the plugin, then choose the name and address your emails come from.', href: '/getting-started/installation/'},
    {title: 'Bring in your contacts', text: 'Import a CSV, or let sign-ups and forms add people as they arrive.', href: '/contacts/import/'},
    {title: 'Send or automate', text: 'Send a campaign to a list, or start an automation from a recipe.', href: '/getting-started/quick-start/'},
];

const tasks = [
    {icon: 'send', title: 'Send a newsletter', text: 'Write an email, choose who gets it, and send it now or at a set time.', href: '/emails/campaigns/'},
    {icon: 'hand', title: 'Welcome new subscribers', text: 'Start the Welcome series recipe and every new member gets three emails over a week.', href: '/automations/'},
    {icon: 'clock', title: 'Run an email course', text: 'A series of emails that each person receives on their own clock from the day they join.', href: '/emails/sequences/'},
    {icon: 'upload', title: 'Move your contacts over', text: 'Export a CSV from your old tool and import it, with tags, lists and custom fields.', href: '/contacts/import/'},
    {icon: 'filter', title: 'Email the right people', text: 'Save conditions as a segment that keeps itself up to date.', href: '/contacts/segments/'},
    {icon: 'chart', title: 'See what worked', text: 'How much was opened, clicked, bounced and unsubscribed over any period.', href: '/reports/email/'},
];

const areas = [
    {icon: 'users', title: 'Contacts', text: 'Everyone you know, organised your way.', href: '/contacts/', links: [['Tags and lists', '/contacts/tags/'], ['Segments', '/contacts/segments/'], ['Import contacts', '/contacts/import/']]},
    {icon: 'mail', title: 'Emails', text: 'Campaigns, sequences and the editor.', href: '/emails/campaigns/', links: [['Campaigns', '/emails/campaigns/'], ['The email editor', '/emails/editor/'], ['Templates', '/emails/templates/']]},
    {icon: 'workflow', title: 'Automations', text: 'Flows that react to what people do.', href: '/automations/', links: [['The builder', '/automations/builder/'], ['Triggers', '/automations/triggers/'], ['Going live', '/automations/going-live/']]},
    {icon: 'chart', title: 'Reports and logs', text: 'What was sent, opened and clicked.', href: '/reports/email/', links: [['Email report', '/reports/email/'], ['Contacts report', '/reports/contacts/'], ['Email log', '/logs/email/']]},
    {icon: 'settings', title: 'Settings', text: 'Sending, consent and who can do what.', href: '/settings/business-profile/', links: [['Email defaults', '/settings/email/'], ['Opt-in & unsubscribe', '/settings/opt-in/'], ['Users and permissions', '/settings/permissions/']]},
    {icon: 'plug', title: 'Connections', text: 'Bring data in from other tools.', href: '/settings/webhooks/', links: [['Incoming webhooks', '/settings/webhooks/'], ['Action links', '/settings/action-links/'], ['Add-ons', '/add-ons/']]},
];


const icon = name => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<div class="home not-content">
    <section class="home-hero">
        <div class="home-hero-text">
            <span class="home-eyebrow">Documentation</span>
            <h1>Run your CRM inside WordPress</h1>
            <p class="home-lead">Step-by-step guides for keeping your contacts in one place, sending emails they want, and following up automatically — all from your WordPress dashboard.</p>
            <button type="button" class="home-search" data-hero-search>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <span>Search the docs…</span>
                <kbd>⌘K</kbd>
            </button>

            <div class="home-actions">
                <a class="home-button home-button--primary" href="/getting-started/">Get started <Fragment set:html={icon('arrow')}/></a>
                <a class="home-button" href="/getting-started/quick-start/">Quick start</a>
            </div>
        </div>

        <nav class="home-popular" aria-labelledby="home-popular-title">
            <h2 id="home-popular-title">Popular</h2>
            <ul>
                {popularPages.map(({title: label, url: href}) => <li><a href={href}>{label}<Fragment set:html={icon('arrow')}/></a></li>)}
            </ul>
        </nav>
    </section>

    <section class="home-section" aria-labelledby="home-start-title">
        <h2 id="home-start-title">Get started in three steps</h2>
        <ol class="home-steps">
            {steps.map((step, index) => (
                <li>
                    <a href={step.href}>
                        <span class="home-step-number">{index + 1}</span>
                        <strong>{step.title}</strong>
                        <span>{step.text}</span>
                    </a>
                </li>
            ))}
        </ol>
    </section>

    <section class="home-section" aria-labelledby="home-tasks-title">
        <h2 id="home-tasks-title">What do you want to do?</h2>
        <div class="home-tasks">
            {tasks.map(task => (
                <a class="home-task" href={task.href}>
                    <span class="home-icon"><Fragment set:html={icon(task.icon)}/></span>
                    <strong>{task.title}</strong>
                    <span>{task.text}</span>
                </a>
            ))}
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-guides-title">
        <h2 id="home-guides-title">Explore the guides</h2>
        <div class="home-areas">
            {areas.map(area => (
                <article class="home-area">
                    <a class="home-area-head" href={area.href}>
                        <span class="home-icon"><Fragment set:html={icon(area.icon)}/></span>
                        <span>
                            <strong>{area.title}</strong>
                            <span>{area.text}</span>
                        </span>
                    </a>
                    <ul>
                        {area.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
                    </ul>
                </article>
            ))}
        </div>
    </section>

    <a class="home-developers" href="/developers/">
        <span class="home-icon"><Fragment set:html={icon('code')}/></span>
        <span>
            <strong>Building on Marker CRM?</strong>
            <span>Hooks, the REST API, and add-ons that register their own triggers, actions and merge tags.</span>
        </span>
        <span class="home-developers-link">Developer docs <Fragment set:html={icon('arrow')}/></span>
    </a>
</div>

<script>
    document.addEventListener('astro:page-load', () => document.querySelectorAll('[data-hero-search]').forEach(button => button.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('mc:open-search'));
    })));
</script>

<style>
    /* The home page draws its own heading, so Starlight's title bar above it goes. */
    :global(.content-panel:has(#_top):has(+ .content-panel .home)) {
        display: none;
    }

    .home {
        --home-border: var(--sl-color-hairline);
        --home-muted: var(--sl-color-gray-3);
        --home-card: var(--sl-color-black);
        display: flex;
        flex-direction: column;
        gap: 4rem;
        padding-bottom: 2rem;
    }

    .home a {
        color: inherit;
        text-decoration: none;
    }

    .home h2 {
        margin: 0 0 1.25rem;
        font-size: var(--sl-text-xl);
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--sl-color-white);
    }

    .home :global(svg) {
        width: 1.1em;
        height: 1.1em;
        flex-shrink: 0;
    }

    .home-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: 3rem;
        align-items: center;
        padding-top: 2rem;
    }

    .home-eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        padding: 0.2rem 0.65rem;
        border: 1px solid var(--home-border);
        border-radius: 999px;
        font-size: var(--sl-text-xs);
        font-weight: 500;
        color: var(--mc-eyebrow);
    }

    .home-hero h1 {
        margin: 0;
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 650;
        line-height: 1.1;
        letter-spacing: -0.025em;
        color: var(--sl-color-white);
    }

    .home-lead {
        max-width: 34rem;
        margin: 1rem 0 0;
        font-size: var(--sl-text-lg);
        line-height: 1.6;
        color: var(--sl-color-gray-2);
    }

    .home-search {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        width: 100%;
        max-width: 30rem;
        height: 3rem;
        margin-top: 1.75rem;
        padding: 0 0.9rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.8rem;
        background: var(--sl-color-bg);
        font: inherit;
        color: var(--sl-color-gray-3);
        text-align: start;
        cursor: pointer;
        transition: border-color 0.15s;
    }

    .home-search:hover { border-color: var(--sl-color-gray-4); color: var(--sl-color-gray-2); }

    .home-search span { flex: 1; }

    .home-search kbd {
        padding: 0.1rem 0.4rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.35rem;
        font-family: inherit;
        font-size: var(--sl-text-xs);
    }

    .home-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.25rem;
    }

    .home-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.1rem;
        border: 1px solid var(--home-border);
        border-radius: 0.6rem;
        font-weight: 500;
        transition: border-color 0.15s, background 0.15s;
    }

    .home-button:hover { border-color: var(--sl-color-gray-4); }

    .home-button--primary {
        border-color: var(--sl-color-white);
        background: var(--sl-color-white);
        color: var(--sl-color-black) !important;
    }

    .home-button--primary:hover { background: var(--sl-color-gray-1); }

    .home-popular {
        padding: 1.25rem 1.25rem 0.75rem;
        border: 1px solid var(--home-border);
        border-radius: 0.9rem;
        background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    }

    .home-popular h2 {
        margin-bottom: 0.5rem;
        font-size: var(--sl-text-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--home-muted);
    }

    .home ul, .home ol {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .home-popular li + li { border-top: 1px solid var(--home-border); }

    .home-popular a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.65rem 0;
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-1);
    }

    .home-popular a :global(svg) { color: var(--home-muted); transition: transform 0.15s, color 0.15s; }
    .home-popular a:hover { color: var(--sl-color-white); }
    .home-popular a:hover :global(svg) { color: var(--sl-color-white); transform: translateX(2px); }

    .home-steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .home-steps a, .home-area {
        height: 100%;
        border: 1px solid var(--home-border);
        border-radius: 0.9rem;
        background: var(--home-card);
        transition: border-color 0.15s;
    }

    .home-steps a {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 1.25rem;
    }

    .home-steps a:hover, .home-area:hover { border-color: var(--sl-color-gray-4); }

    .home-step-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        margin-bottom: 0.5rem;
        border-radius: 999px;
        background: var(--sl-color-accent-low);
        font-size: var(--sl-text-sm);
        font-weight: 600;
        color: var(--sl-color-accent-high);
    }

    .home-steps strong, .home-area strong, .home-developers strong {
        font-weight: 600;
        color: var(--sl-color-white);
    }

    .home-steps a > span:last-child, .home-area-head span span {
        font-size: var(--sl-text-sm);
        line-height: 1.55;
        color: var(--home-muted);
    }

    .home-areas {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .home-area {
        display: flex;
        flex-direction: column;
        padding: 1.25rem;
    }

    .home-area-head {
        display: flex;
        gap: 0.85rem;
        margin-bottom: 1rem;
    }

    .home-area-head > span:last-child {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .home-icon :global(svg) { width: 1.15rem; height: 1.15rem; }

    .home-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        flex-shrink: 0;
        border-radius: 0.6rem;
        background: var(--sl-color-accent-low);
        color: var(--sl-color-accent-high);
    }

    .home-area ul {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-top: auto;
        padding-top: 0.85rem;
        border-top: 1px solid var(--home-border);
    }

    .home-area li a {
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-2);
    }

    .home-area li a::after { content: ' →'; opacity: 0; transition: opacity 0.15s; }
    .home-area li a:hover { color: var(--sl-color-accent); }
    .home-area li a:hover::after { opacity: 1; }

    .home-tasks {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .home-task {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 1.25rem;
        border: 1px solid var(--home-border);
        border-radius: 0.9rem;
        background: var(--home-card);
        transition: border-color 0.15s;
    }

    .home-task:hover { border-color: var(--sl-color-gray-4); }

    .home-task .home-icon { margin-bottom: 0.5rem; }

    .home-task strong { font-weight: 600; color: var(--sl-color-white); }

    .home-task > span:last-child {
        font-size: var(--sl-text-sm);
        line-height: 1.55;
        color: var(--home-muted);
    }

    .home-developers {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border: 1px solid var(--home-border);
        border-radius: 0.9rem;
        transition: border-color 0.15s;
    }

    .home-developers:hover { border-color: var(--sl-color-gray-4); }

    .home-developers > span:nth-child(2) {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.15rem;
    }

    .home-developers > span:nth-child(2) > span {
        font-size: var(--sl-text-sm);
        color: var(--home-muted);
    }

    .home-developers-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: var(--sl-text-sm);
        font-weight: 500;
        white-space: nowrap;
    }

    .home-developers:hover .home-developers-link { color: var(--sl-color-accent); }

    @media (max-width: 64rem) {
        .home-areas, .home-tasks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 48rem) {
        .home { gap: 3rem; }
        .home-hero, .home-steps, .home-areas, .home-tasks { grid-template-columns: minmax(0, 1fr); }
        .home-developers { flex-wrap: wrap; }
        .home-hero { gap: 2rem; padding-top: 0.5rem; }
    }
</style>
